    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 제품군 x 회차의 모든 조합을 한 줄씩 만든다. 조합 수는 두 목록 길이의 곱이다.\nconst families = $('Check families').first().json.families;\nconst rounds = $('Check rounds').first().json.rounds;\nconst out = [];\nfor (const f of families) {\n  for (const r of rounds) {\n    out.push({ json: { family_id: f.family_id, family_name: f.name, round_id: r.round_id, round_label: r.label } });\n  }\n}\nreturn out;"
      },
