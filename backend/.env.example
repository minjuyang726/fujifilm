# 이 파일은 항목 이름만 적는다. 실제 값은 backend/.env에 직접 넣는다. (.env는 저장소에 올리지 않는다)

# Supabase session pooler 접속 문자열
DATABASE_URL=

# 광고성 판정(호출 A)에 쓴다. 키와 모델 이름은 코드에 쓰지 않고 여기서만 읽는다.
OPENAI_API_KEY=
OPENAI_MODEL_AD=
# 액션 제안 서술(호출 B)에 쓴다. 판정과 같은 모델 이름을 넣어도 된다.
OPENAI_MODEL_SUGGEST=
# 다음 회차 문항 초안(호출 C)에 쓴다. 같은 모델 이름을 넣어도 된다.
OPENAI_MODEL_QUESTION=

# 한 번의 광고성 판정 실행에서 LLM에 보내는 글 수의 상한. 비워 두면 100.
# 310건 전체 실행은 prd.md Q-17-3이 해결된 뒤에만 이 값을 올린다.
AD_JUDGEMENT_MAX_ITEMS=

# 비용 가드(광고성 판정). 호출 전 예상 비용 상한이 한도를 넘으면 호출하지 않는다.
# 한도(USD)는 비워 두면 0.5. 단가(100만 토큰당 USD)는 비워 두면 호출하지 않는다(500).
AD_JUDGEMENT_COST_LIMIT_USD=
OPENAI_PRICE_INPUT_PER_M=
OPENAI_PRICE_OUTPUT_PER_M=

# 액션 제안 서술(호출 B) 실행당 예상 비용 한도(USD). 비워 두면 0.5(임시). 단가는 위 OPENAI_PRICE_* 를 같이 쓴다.
SUGGESTION_COST_LIMIT_USD=

# 다음 회차 문항 초안(호출 C) 실행당 예상 비용 한도(USD). 비워 두면 0.5(임시).
QUESTION_COST_LIMIT_USD=

# 가중치 하한(0 이상 1 미만). 비워 두면 0.1. 임시 값이고 근거가 약하다(prd.md Q-7).
AD_WEIGHT_FLOOR=

# 브라우저에서 backend를 부를 수 있는 주소(쉼표로 구분). 비워 두면 http://localhost:5173
CORS_ORIGINS=

# 네이버 API HUB 검색(Phase 0d 제한 구현: 검색 결과 건수만 저장). 실제 호출은 사용자 승인 후에 한다.
NAVER_API_CLIENT_ID=
NAVER_API_CLIENT_SECRET=
